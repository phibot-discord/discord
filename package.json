{
  "name": "phi-discord",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Lightweight Discord host with a file-based plugin API and Takumi image rendering",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "prepare-render": "node scripts/precompile-art.mjs && node scripts/bundle-css.mjs",
    "start": "pnpm prepare-render && tsx src/index.ts",
    "dev": "pnpm prepare-render && tsx watch src/index.ts",
    "typecheck": "pnpm prepare-render && tsc --noEmit",
    "test": "pnpm prepare-render && node --import tsx --test 'src/**/*.test.ts' 'plugins/**/*.test.ts'",
    "sync-assets": "node scripts/sync-phi-assets.mjs && pnpm prepare-render",
    "fmt": "pnpx @biomejs/biome format --write"
  },
  "dependencies": {
    "@takumi-rs/core": "2.14.0",
    "art-template": "^4.13.4",
    "discord.js": "^14.27.0",
    "jszip": "^3.10.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "takumi-js": "^2.14.0",
    "undici": "^8.11.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
